OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-5
# Reasoning depth -- reasoning models only (gpt-5*, o-series): minimal|low|medium|high.
# Blank => provider default (medium for gpt-5). Ignored by gpt-4o*/gpt-4.1*.
LLM_REASONING_EFFORT=

# --- bdapps CaaS (Charging-as-a-Service) sidecar ---
# Leave BDAPPS_SIMULATE=true for the demo: the sidecar runs a deterministic
# local charge simulator, so no credentials or network are required. Flip to
# false and fill in the real values (from https://developer.bdapps.com) to hit
# the live sandbox/production charging API.
BDAPPS_SIMULATE=true
BDAPPS_APP_ID=
BDAPPS_APP_PASSWORD=
BDAPPS_ACCOUNT_ID=
# Defaults to https://developer.bdapps.com/caas/direct/debit; set only to override.
BDAPPS_CHARGE_URL=
BDAPPS_CURRENCY=BDT
BDAPPS_ADVISORY_FEE_BDT=20
BDAPPS_SIM_INITIAL_BALANCE=1000
# Optional shared secret required on POST /bdapps/notify (?token=... or the
# X-Notify-Token header). Leave blank to keep the callback open for the sandbox.
BDAPPS_NOTIFY_TOKEN=
# Your public tunnel/Render URL, e.g. https://agrisense.example.com -- used only
# to print the exact host address to register and to build absolute receipt links.
BDAPPS_PUBLIC_BASE_URL=
# Where the Streamlit "Pay via bdapps" panel sends checkout calls.
BDAPPS_SIDECAR_URL=http://localhost:8000

# --- Neon PostgreSQL (persistence: users, conversations, usage) ---
# Pooled connection string from the Neon dashboard. On Streamlit Cloud this is
# set in the Secrets manager; locally, paste it here. Leave blank to run in
# session-only mode (no login/history persistence).
DATABASE_URL=

# --- Agent usage limits (rolling 24h; values <= 0 disable a check) ---
RATE_LIMIT_PER_USER_PER_DAY=20
RATE_LIMIT_GLOBAL_PER_DAY=200
