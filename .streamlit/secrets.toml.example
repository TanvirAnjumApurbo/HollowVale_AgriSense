OPENAI_API_KEY = "sk-..."

# Optional fallback provider if OpenAI credit runs low; only used if LLM_PROVIDER=groq
# GROQ_API_KEY = "gsk_..."

# Optional, only needed once Tier 2 bdapps CaaS is wired in
# BDAPPS_APPLICATION_ID = "APP_000000"
# BDAPPS_PASSWORD = "..."

# Neon PostgreSQL pooled connection string (persistence: users, conversations,
# usage). Already set in the Streamlit Cloud Secrets manager for the deployed app.
# DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Agent usage limits (rolling 24 h window; values <= 0 disable a check).
# RATE_LIMIT_PER_USER_PER_DAY = "20"
# RATE_LIMIT_GLOBAL_PER_DAY = "200"
